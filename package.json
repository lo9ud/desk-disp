{
  "name": "desk-disp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen-types": "cd src-tauri && cargo test",
    "gen-licenses": "node scripts/gen-licenses.mjs",
    "reset-dev-config": "node scripts/reset-dev-config.mjs",
    "watch-mem": "node scripts/webview-memory-snapshot.mjs",
    "dev": "vite",
    "typecheck": "tsc",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:predev": "pnpm dev",
    "tauri:prebuild": "pnpm gen-types && pnpm gen-licenses && pnpm build",
    "gen-icons": "tauri icon ./icon-dark.svg -o ./src-tauri/icons/dark --ios-color #1a1a1a && tauri icon ./icon-light.svg -o ./src-tauri/icons/light --ios-color #ffffff",
    "task": "node scripts/todos.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.2.8",
    "react-devtools": "^7.0.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "type-fest": "^5.8.0",
    "typescript": "~5.8.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^7.3.6"
  }
}
